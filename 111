<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sorteo V2</title>
<style>
:root{--p:#5b4bdb;--bg:#f5f6fa;--text:#171923;--muted:#70758a;--border:#e5e6ee;--red:#d9363e;--yellow:#ffe9a8}*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:var(--bg);color:var(--text)}button,input{font:inherit}.header{background:#fff;border-bottom:1px solid var(--border)}.head,main,.admin{max-width:1180px;margin:auto}.head{min-height:80px;padding:12px 22px;display:flex;justify-content:space-between;align-items:center}.logo{width:180px;height:55px;border:2px dashed #bbb;border-radius:10px;display:grid;place-items:center;color:var(--muted);font-size:13px}.adminbtn,.secondary{background:#fff;border:1px solid var(--border);padding:10px 15px;border-radius:9px;cursor:pointer}main{padding:35px 22px 80px}.draw{text-align:center;color:var(--p);font-weight:bold;text-transform:uppercase;letter-spacing:1px}h1{text-align:center;font-size:clamp(32px,5vw,52px);margin:8px 0}.sub{text-align:center;color:var(--muted)}.section{margin-top:38px}.title{text-align:center;margin-bottom:18px}.title h2{margin:0}.title p{color:var(--muted);font-size:14px}.prizes{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.prize,.box,.card,.admininner{background:#fff;border:1px solid var(--border);border-radius:17px;box-shadow:0 8px 25px #0000000d}.photo{height:210px;background:#eee;display:grid;place-items:center;color:#888}.pbody{padding:18px}.pbody h3{margin:5px 0}.pbody p{color:var(--muted);font-size:14px}.box{padding:22px}.toolbar{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:16px}.search{padding:10px;border:1px solid var(--border);border-radius:9px;width:230px}.numbers{display:grid;grid-template-columns:repeat(10,1fr);gap:7px;max-height:470px;overflow:auto}.num{min-height:42px;border:1px solid var(--border);background:#fff;border-radius:7px;font-weight:bold;cursor:pointer}.num.selected{background:var(--p);color:#fff}.num.reserved{background:var(--yellow);color:#705900;border-color:#dfc65e;cursor:not-allowed}.num.sold{background:var(--red);color:#fff;border-color:var(--red);cursor:not-allowed}.legend{margin-top:14px;color:var(--muted);font-size:12px}.checkout{display:grid;grid-template-columns:1fr 350px;gap:22px;margin-top:22px}.card{padding:22px}.form{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{display:flex;flex-direction:column;gap:6px}.field label,.cfg label{font-size:13px;font-weight:bold}.field input,.cfg input{padding:11px;border:1px solid var(--border);border-radius:9px}.full{grid-column:1/-1}.summary{color:var(--muted);font-size:14px;line-height:1.7}.selected{padding:12px;background:#f7f7fa;border-radius:9px;margin:10px 0}.primary{width:100%;border:0;background:var(--p);color:#fff;border-radius:9px;padding:12px;font-weight:bold;cursor:pointer}.admin{display:none;padding:0 22px 70px}.admin.show{display:block}.admininner{padding:24px}.cfgs{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin-top:20px}.cfg{display:flex;flex-direction:column;gap:6px}.cfg.full{grid-column:1/-1}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:20px 0}.stat{border:1px solid var(--border);padding:16px;border-radius:12px}.stat small{color:var(--muted)}.stat strong{display:block;font-size:24px;margin-top:7px}.notice{margin-top:15px;padding:12px;border-radius:10px;background:#f7f6ff;color:#5148a1;font-size:13px;line-height:1.5}.overlay{position:fixed;inset:0;background:#0008;display:none;place-items:center;z-index:5}.login{background:#fff;padding:28px;border-radius:16px;width:min(400px,90%)}.login input{width:100%;padding:12px;margin:10px 0;border:1px solid var(--border);border-radius:9px}.actions{display:flex;gap:8px}.actions>*{flex:1;padding:11px;border-radius:9px;border:1px solid var(--border);cursor:pointer}.actions .enter{background:var(--p);color:#fff;border-color:var(--p)}@media(max-width:850px){.prizes,.checkout{grid-template-columns:1fr}.numbers{grid-template-columns:repeat(6,1fr)}.stats,.cfgs{grid-template-columns:1fr}}@media(max-width:520px){main,.admin{padding-left:12px;padding-right:12px}.logo{width:135px}.numbers{grid-template-columns:repeat(5,1fr)}.form{grid-template-columns:1fr}.full,.cfg.full{grid-column:auto}}
</style></head><body>
<header class="header"><div class="head"><div class="logo">TU LOGO</div><button class="adminbtn" id="open">Administración</button></div></header>
<main>
<div class="draw">Sorteo número 001</div><h1>Gran Sorteo de Octubre</h1><p class="sub">Seleccioná tus números y completá tus datos para generar una reserva.</p>
<section class="section"><div class="title"><h2>Premios</h2><p>Hasta 3 premios configurables</p></div><div class="prizes">
<article class="prize"><div class="photo">FOTO PREMIO 1</div><div class="pbody"><b>1° PREMIO</b><h3>$5.000.000</h3><p>Descripción del premio.</p></div></article>
<article class="prize"><div class="photo">FOTO PREMIO 2</div><div class="pbody"><b>2° PREMIO</b><h3>$1.000.000</h3><p>Descripción del premio.</p></div></article>
<article class="prize"><div class="photo">FOTO PREMIO 3</div><div class="pbody"><b>3° PREMIO</b><h3>$500.000</h3><p>Descripción del premio.</p></div></article></div></section>
<section class="section"><div class="title"><h2>Elegí tus números</h2><p>0000 - 9999</p></div><div class="box"><div class="toolbar"><b>Números disponibles</b><input class="search" id="search" type="number" min="0" max="9999" placeholder="Buscar número"></div><div class="numbers" id="numbers"></div><div class="legend">⬜ Disponible &nbsp; 🟪 Seleccionado &nbsp; 🟨 Reservado &nbsp; 🟥 Vendido</div></div></section>
<section class="checkout"><div class="card"><h3>Datos del comprador</h3><p class="summary">Estos datos acompañarán la reserva enviada a WhatsApp.</p><div class="form"><div class="field"><label>Nombre</label><input id="name"></div><div class="field"><label>Apellido</label><input id="last"></div><div class="field"><label>DNI</label><input id="dni" inputmode="numeric"></div><div class="field"><label>Teléfono</label><input id="phone" type="tel"></div></div></div><div class="card"><h3>Reserva</h3><div class="summary">Cantidad seleccionada: <b id="count">0</b></div><div class="selected" id="list">No seleccionaste números.</div><div class="summary">Máximo por usuario: <b id="max">10</b><br>Tiempo de reserva: <b id="hours">6 horas</b></div><button class="primary" id="reserve">Reservar y enviar por WhatsApp</button></div></section>
</main>
<section class="admin" id="admin"><div class="admininner"><h2>Panel de administración</h2><p class="summary">Configuración del sorteo.</p><div class="cfgs"><div class="cfg"><label>Máximo de números por usuario</label><input id="maxInput" type="number" min="1" value="10"></div><div class="cfg"><label>Tiempo de reserva (horas)</label><input id="hoursInput" type="number" min="1" value="6"></div><div class="cfg full"><label>Número de WhatsApp que recibe las reservas</label><input id="wa" value="5493510000000" placeholder="Ej: 5493511234567"></div></div><button class="primary" style="margin-top:14px;max-width:260px" id="save">Guardar configuración</button><div class="stats"><div class="stat"><small>Disponibles</small><strong id="available">0</strong></div><div class="stat"><small>Reservados</small><strong id="reserved">6</strong></div><div class="stat"><small>Vendidos</small><strong id="sold">18</strong></div></div><div class="notice"><b>Flujo real:</b> la reserva se guardará en Firebase, los números quedarán amarillos durante el tiempo configurado, se enviará la reserva por WhatsApp y, cuando se confirme el pago, administración los pasará a vendidos (rojo). Al vencer una reserva sin pago, volverán automáticamente a disponibles. El bloqueo simultáneo se hará con transacciones de Firebase.</div></div></section>
<div class="overlay" id="overlay"><div class="login"><h2>Administración</h2><p class="summary">Contraseña de acceso.</p><input id="pass" type="password" placeholder="Contraseña"><div id="err" style="color:#c44;font-size:13px;min-height:18px"></div><div class="actions"><button id="close">Cancelar</button><button class="enter" id="login">Ingresar</button></div></div></div>
<script>
const TOTAL=10000;let maxPurchase=10,reservationHours=6,wa="5493510000000";const sold=new Set([7,18,42,125,310,777,1024,1234,2345,3456,4567,5000,5821,6123,7001,8123,9000,9876]),reserved=new Set([12,99,202,1500,4444,8888]),selected=new Set();
const nums=document.getElementById("numbers");function f(n){return String(n).padStart(4,"0")}function render(filter=""){nums.innerHTML="";let a=0,b=TOTAL;if(filter!==""){let n=Number(filter);if(Number.isInteger(n)&&n>=0&&n<TOTAL){a=n;b=n+1}}for(let i=a;i<b;i++){let x=document.createElement("button");x.className="num";x.textContent=f(i);if(sold.has(i)){x.classList.add("sold");x.disabled=true}else if(reserved.has(i)){x.classList.add("reserved");x.disabled=true}else if(selected.has(i))x.classList.add("selected");x.onclick=()=>{if(selected.has(i))selected.delete(i);else if(selected.size<maxPurchase)selected.add(i);else return alert("Alcanzaste el máximo permitido.");render(document.getElementById("search").value);update()};nums.appendChild(x)}}function update(){document.getElementById("count").textContent=selected.size;document.getElementById("list").textContent=selected.size?[...selected].sort((a,b)=>a-b).map(f).join(" - "):"No seleccionaste números.";document.getElementById("max").textContent=maxPurchase;document.getElementById("hours").textContent=reservationHours+" horas";document.getElementById("available").textContent=TOTAL-sold.size-reserved.size}document.getElementById("search").oninput=e=>render(e.target.value);render();update();
document.getElementById("save").onclick=()=>{maxPurchase=+document.getElementById("maxInput").value;reservationHours=+document.getElementById("hoursInput").value;wa=document.getElementById("wa").value.replace(/\D/g,"");if(selected.size>maxPurchase)selected.clear();render();update();alert("Configuración actualizada en esta demo.")};
document.getElementById("reserve").onclick=()=>{let n=document.getElementById("name").value.trim(),l=document.getElementById("last").value.trim(),d=document.getElementById("dni").value.trim(),p=document.getElementById("phone").value.trim();if(!selected.size)return alert("Seleccioná números.");if(!n||!l||!d||!p)return alert("Completá nombre, apellido, DNI y teléfono.");let list=[...selected].sort((a,b)=>a-b).map(f).join(" - ");let msg=`RESERVA - Sorteo 001\nNombre: ${n} ${l}\nDNI: ${d}\nTeléfono: ${p}\nNúmeros: ${list}\nCantidad: ${selected.size}\nReserva: ${reservationHours} horas`;window.open("https://wa.me/"+wa+"?text="+encodeURIComponent(msg),"_blank")};
const ov=document.getElementById("overlay");document.getElementById("open").onclick=()=>ov.style.display="grid";document.getElementById("close").onclick=()=>ov.style.display="none";document.getElementById("login").onclick=()=>{if(document.getElementById("pass").value==="admin123"){ov.style.display="none";document.getElementById("admin").classList.add("show");document.getElementById("admin").scrollIntoView({behavior:"smooth"})}else document.getElementById("err").textContent="Contraseña incorrecta."};
</script></body></html>
